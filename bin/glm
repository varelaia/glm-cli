#!/usr/bin/env bash
# glm — Claude Code on Z.ai GLM-4.7 (200K context, thinking ON).
#
# The ANTHROPIC_* exports below are scoped to THIS invocation only, so your
# default `claude` command (Anthropic / Max plan) is never modified. Think of
# glm as: "claude, but routed to Z.ai GLM-4.7 for this one run."
#
# Rollback: rm -f ~/.zai_api_key ~/.local/bin/glm ~/.local/bin/glmf
set -euo pipefail

KEY_FILE="${HOME}/.zai_api_key"
ZAI_KEY="$(cat "$KEY_FILE" 2>/dev/null || true)"
if [ -z "$ZAI_KEY" ]; then
  echo "❌ No Z.ai API key at ${KEY_FILE}." >&2
  echo "   Create one at https://z.ai/manage-apikey and re-run install.sh" >&2
  echo "   (or: ZAI_API_KEY=<key> bash install.sh)." >&2
  exit 1
fi

# ANTHROPIC_MODEL is pinned explicitly: a literal "model" id in the host's
# ~/.claude/settings.json (written by /model) bypasses the DEFAULT_* aliases
# and silently routes the session to a non-GLM model id — Z.ai may serve a
# different model without any error. Pinning the env var wins over settings.json.
# Override the model for one run with GLM_MODEL: GLM_MODEL=glm-5.2[1m] glm
ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
ANTHROPIC_AUTH_TOKEN="$ZAI_KEY" \
ANTHROPIC_MODEL="${GLM_MODEL:-glm-4.7}" \
ANTHROPIC_DEFAULT_OPUS_MODEL="glm-4.7" \
ANTHROPIC_DEFAULT_SONNET_MODEL="glm-4.7" \
ANTHROPIC_DEFAULT_HAIKU_MODEL="glm-4.5-air" \
CLAUDE_CODE_AUTO_COMPACT_WINDOW="200000" \
API_TIMEOUT_MS="3000000" \
exec claude "$@"
